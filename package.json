{
  "name": "rig-bridge",
  "version": "0.1.2",
  "description": "A workstation bridge exposing local tools and workspaces over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dna113p/rig-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/dna113p/rig-bridge/issues"
  },
  "homepage": "https://github.com/dna113p/rig-bridge#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "serve": "node src/cli.ts serve",
    "tunnel": "node scripts/run-tunnel.ts",
    "tunnel:watchdog": "bash scripts/tunnel-watchdog.sh",
    "install:service": "node scripts/install-service.ts",
    "install:tunnel": "node scripts/install-tunnel-service.ts",
    "install:tunnel-service": "node scripts/install-tunnel-service.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:tunnel": "node --test tests/tunnel.integration.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
